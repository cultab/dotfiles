#!/bin/sh


# bspc monitor "$MONITOR" --reset-desktops I II III IV V VI

# bspc wm --reorder-monitors HDMI1 LVDS1
# bspc monitor HDMI1 --reset-desktops I II III IV V VI
# bspc monitor LVDS1 --reset-desktops I II III IV V VI

MONITOR=$(xrandr | grep ' connected' | cut -d ' ' -f1)

if [ $(echo "$MONITOR" | wc -l) = "1" ]; then
    bspc monitor "$MONITOR" --reset-desktops I II III IV V VI
    bspc monitor "$MONITOR" --swap '^1'
    xrandr --output "$MONITOR" --primary
else
    if [ "$(hostname)" = "L-5CG54917G7" ]; then
        xrandr --output DP-1-8 --primary
        xrandr --output DP-1-1 --left-of DP-1-8
        xrandr --output eDP-1 --right-of DP-1-8

        bspc wm --reorder-monitors 'DP-1-1 DP-1-8 eDP-1'
        # bspc monitor DP-1-1 --reset-desktops
        # bspc monitor eDP-1 --reset-desktops
        bspc monitor DP-1-8 --reset-desktops I II III IV V VI
        bspc monitor DP-1-8 --swap '^1'
    else
        bspc wm --reorder-monitors HDMI1 LVDS1
        bspc monitor HDMI1 --reset-desktops I II III IV V VI
        bspc monitor LVDS1 --reset-desktops I II III IV V VI
    fi
fi

# ignore DISCORD
bspc config ignore_ewmh_focus true

DB=$(xrdb -query)
active=$(echo "$DB" | grep '\*.active' | cut -f 2 -d ':' | sed 's/\t//')
background=$(echo "$DB" | grep '\*foreground' | cut -f 2 -d ':' | sed 's/\t//')

bspc config focused_border_color "$active"
bspc config presel_feedback_color "$active"
bspc config presel_feedback true

bspc config split_ratio          0.50

bspc config border_width 4
bspc config window_gap 4 # themr:bspwm-window_gap #
bspc config borderless_monocle   true
bspc config gapless_monocle      true
bspc config single_monocle true # themr:bspwm-single_monocle #

# bspc config automatic_scheme spiral
bspc config automatic_scheme alternate

bspc config focus_follows_pointer true

bspc rule -a Zathura state=tiled
bspc rule -a Surf    state=tiled

bspc rule -a "$BROWSER"     desktop='^1'
bspc rule -a discord        desktop='^5'
bspc rule -a FFPWA-01KYW5VBPSDK1AKPVQ5Z8Y7GES desktop='^5' # teams
bspc rule -a FFPWA-01KYW5DZYND8A7HHQNYA47M2C9 desktop='^4' # outlook

bspc rule -a MEGAsync            state=floating
bspc rule -a Pavucontrol         state=floating
bspc rule -a Blueman-manager     state=floating
bspc rule -a KeePassXC:keepassxc state=floating desktop='^6'
bspc rule -a Barrier             state=floating desktop='^6'
bspc rule -a kdeconnect.app      state=floating desktop='^6'
bspc rule -a ZSTray              state=floating desktop='^6'

bspc rule -a activate-linux           layer=above
bspc rule --add "Polybar tray window" layer=above border=on # does it work?

# bspc rule --add "Polybar" layer=above border=off # does it work?

bspc rule -a Screenkey manage=off

if pgrep xfce4 > /dev/null; then
    bspc config top_padding 21
fi
bspc rule -a Plank manage=on border=off locked=on focus=off follow=off

# Started here rather than from startwm so that it also comes back after a
# config reload, and after the monitor layout above has been applied.
# quickshell_start

notify-send -a bspwm "Reloaded" "bspwm config"

