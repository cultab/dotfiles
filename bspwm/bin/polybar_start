#!/bin/sh

for If in $(ip addr | grep "^[0-9]" | cut -d ':' -f 2 | sed "s/\s*//g"); do
    case "$If" in
        wl*)
            export WIRELESS_INTERFACE="$If"
            ;;
        en*)
            export WIRED_INTERFACE="$If"
            ;;
        *)
            echo "Ignoring interface $If"
            ;;
    esac
done

echo ===============

if command -v "xrandr"; then
    PRIMARY=$(xrandr --query | grep " connected.*primary" | cut -d" " -f1)
    MONITOR=$PRIMARY polybar --reload mybar -c ~/.config/polybar/config.ini &
    # for m in $(xrandr --query | grep " connected" | grep -v 'primary' | cut -d" " -f1); do
    #     MONITOR=$m polybar --reload sidebar -c ~/.config/polybar/config.ini &
    # done
else
    polybar --reload mybar &
fi

pkill -f 'polybar --reload traybar'
polybar --reload traybar -c ~/.config/polybar/traybar.ini &
pid=$!
sh -c "sleep 5; polybar-msg -p $pid cmd hide" &
