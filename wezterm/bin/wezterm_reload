#!/bin/sh

WATCH_PATH="$HOME/dotfiles/wezterm/.config/wezterm"
# HACK: inotifywait does not work nice with symlinks so watching ~/.config itself fails
# maybe move wezterm intenal to dot/wez
WATCH_PATH2="$HOME/dotfiles/work/.config/wezterm"
DEST_PATH="/mnt/c/Users/$USER/.config/wezterm/"

inotifywait -r -m "$WATCH_PATH" "$WATCH_PATH2" 2> /dev/null | while read -r dir event file; do
	if [ "$event" = "MODIFY" ]; then
		case $file in
			Xresources*) echo x;;
			selected_theme*) echo st;;
			*)  case $dir in
				*colors*)
					cp -f "$dir$file" "${DEST_PATH}colors"
					# echo "1cp -f $dir$file ${DEST_PATH}colors"
					;;
				*)
					cp -f "$dir$file" "$DEST_PATH"
					# echo "2cp -f $dir$file $DEST_PATH"
					;;
			esac
		esac
	fi
done
